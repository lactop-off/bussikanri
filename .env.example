# Karidasu 環境設定。`cp .env.example .env` して編集してください。
# （.env はコミットしないこと / 設計書 §11）

# --- 必須 ---
# JWT 署名鍵。十分に長いランダム文字列を設定（例: openssl rand -hex 32）。
JWT_SECRET=please-change-me-to-a-long-random-string

# --- 公開設定 ---
# 公開ドメインを設定すると Caddy が Let's Encrypt で自動 TLS を取得します。
# 例: SITE_ADDRESS=karidasu.example.com
# 未設定（:80）の場合はローカル HTTP で起動します。
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# --- DB ---
POSTGRES_PASSWORD=change-this-db-password

# --- 初回管理者（初回起動時に自動作成） ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=管理者

# --- 業務既定値（設計書 付録B） ---
DEFAULT_LOAN_DAYS=14
ASSET_TAG_PREFIX=KRD-
ORG_NAME=Karidasu

# --- 督促 / メール（任意） ---
REMINDER_CRON=0 9 * * *
# SMTP_URL=smtp://user:pass@smtp.example.com:587
MAIL_FROM=karidasu@example.com

# --- CORS（同一オリジン配信なら * のままで可） ---
CORS_ORIGINS=*
